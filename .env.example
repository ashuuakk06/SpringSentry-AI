# Optional: without a key, the backend returns clearly labelled local demo analyses.
BHARATCODE_API_KEY=replace_with_your_server_side_key
BHARATCODE_MODEL=qwen-3.8-27b

# Replace before any deployment. This local value is only a development placeholder.
SPRINGSENTRY_JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes

# Optional PostgreSQL settings when using the postgres Spring profile.
SPRINGSENTRY_DB_URL=jdbc:postgresql://localhost:5432/springsentry
SPRINGSENTRY_DB_USERNAME=springsentry
SPRINGSENTRY_DB_PASSWORD=replace_with_a_local_database_password
